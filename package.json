{
  "name": "spudstead-argon",
  "version": "1.0.0",
  "private": false,
  "description": "SPUDSTEAD — A complete, original specialty-potato farming simulator",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "generate:assets": "python3 scripts/generate_assets.py"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/three": "^0.186.0",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
